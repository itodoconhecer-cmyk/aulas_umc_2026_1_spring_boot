style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="2200" y="300" width="80" height="120" as="geometry"/></mxCell><mxCell id="diag" value="Profissional de Apoio Diagnóstico" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="2200" y="700" width="80" height="120" as="geometry"/></mxCell><mxCell id="fin" value="Administrativo / Financeiro" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="2200" y="1100" width="80" height="120" as="geometry"/></mxCell><mxCell id="dir" value="Direção / Gestão" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="2200" y="1500" width="80" height="120" as="geometry"/></mxCell><mxCell id="conv" value="&lt;&lt;external system&gt;&gt;&lt;br&gt;&lt;b&gt;Operadora / Convênio de Saúde&lt;/b&gt;&lt;br&gt;Elegibilidade, autorização e faturamento" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;strokeWidth=2;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="300" y="1700" width="400" height="160" as="geometry"/></mxCell><mxCell id="lab" value="&lt;&lt;external system&gt;&gt;&lt;br&gt;&lt;b&gt;Laboratório / Serviço Diagnóstico Externo&lt;/b&gt;&lt;br&gt;Pedidos e resultados" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;strokeWidth=2;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="800" y="1700" width="400" height="160" as="geometry"/></mxCell><mxCell id="notif" value="&lt;&lt;external system&gt;&gt;&lt;br&gt;&lt;b&gt;Serviço de Notificações&lt;/b&gt;&lt;br&gt;E-mail, SMS ou mensageria" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;strokeWidth=2;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1300" y="1700" width="400" height="160" as="geometry"/></mxCell><mxCell id="pay" value="&lt;&lt;external system&gt;&gt;&lt;br&gt;&lt;b&gt;Plataforma de Pagamentos&lt;/b&gt;&lt;br&gt;Cobranças e confirmações" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;strokeWidth=2;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1800" y="1700" width="400" height="160" as="geometry"/></mxCell><mxCell id="scope" value="ESCOPO&lt;br&gt;Esta é uma visão-alvo do sistema completo da clínica. O código atual do repositório cobre principalmente cadastro de Pessoa/Paciente e persistência relacionada." style="shape=note;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="800" y="200" width="900" height="180" as="geometry"/></mxCell><mxCell id="e1" value="Solicita cadastro, consulta, agendamento e recebe orientações" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=50;html=1;endArrow=open;endFill=0;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="pac" target="system"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="500" y="360"/><mxPoint x="500" y="800"/><mxPoint x="1000" y="800"/></Array></mxGeometry></mxCell><mxCell id="e2" value="Cadastra paciente, agenda, realiza check-in" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=50;html=1;endArrow=open;endFill=0;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="rec" target="system"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="600" y="760"/><mxPoint x="600" y="900"/><mxPoint x="1000" y="900"/></Array></mxGeometry></mxCell><mxCell id="e3" value="Registra acolhimento e sinais vitais" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=50;html=1;endArrow=open;endFill=0;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="enf" target="system"><mxGeometry relative="1" as="geometry"><Array as="points"><mx