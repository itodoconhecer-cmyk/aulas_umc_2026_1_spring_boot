<mxfile host="app.diagrams.net" modified="2026-09-29T20:10:00.000Z" agent="ChatGPT" version="26.0.0"><diagram id="c4_context_clinic_people_needs" name="C4 System Context - Clínica"><mxGraphModel dx="3000" dy="2300" grid="1" gridSize="100" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2900" pageHeight="2300" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="C4 — System Context Diagram — Sistema da Clínica Médica&lt;br&gt;&lt;font style='font-size:14px;font-weight:normal'&gt;Pessoas, necessidades, sistema em foco e dependências externas&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=26;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="500" y="0" width="2200" height="100" as="geometry"/></mxCell><mxCell id="system" value="Software System&lt;br&gt;&lt;b&gt;Sistema da Clínica Médica&lt;/b&gt;&lt;br&gt;&lt;br&gt;Centraliza a jornada do paciente e apoia a operação da clínica: cadastro, agenda, recepção, acolhimento, atendimento, exames, retorno, faturamento e informações gerenciais." style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fontStyle=1;strokeWidth=3;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1100" y="800" width="700" height="500" as="geometry"/></mxCell><mxCell id="pac" value="Person&lt;br&gt;&lt;b&gt;Paciente&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Necessidades:&lt;/b&gt;&lt;br&gt;• cadastrar-se&lt;br&gt;• agendar atendimento&lt;br&gt;• receber orientações e confirmações&lt;br&gt;• acompanhar retornos" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;strokeWidth=2;fillColor=#08427B;strokeColor=#052E56;fontColor=#ffffff;align=left;verticalAlign=middle;spacingLeft=130;spacingRight=20;" vertex="1" parent="1"><mxGeometry x="100" y="200" width="500" height="260" as="geometry"/></mxCell><mxCell id="pac_head" value="" style="ellipse;html=1;fillColor=#ffffff;strokeColor=#ffffff;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="145" y="245" width="60" height="60" as="geometry"/></mxCell><mxCell id="pac_body" value="" style="rounded=1;arcSize=30;html=1;fillColor=#ffffff;strokeColor=#ffffff;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="130" y="315" width="90" height="95" as="geometry"/></mxCell><mxCell id="rec" value="Person&lt;br&gt;&lt;b&gt;Recepcionista&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Necessidades:&lt;/b&gt;&lt;br&gt;• cadastrar e localizar pacientes&lt;br&gt;• organizar agenda&lt;br&gt;• realizar check-in&lt;br&gt;• confirmar documentação" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;strokeWidth=2;fillColor=#08427B;strokeColor=#052E56;fontColor=#ffffff;align=left;verticalAlign=middle;spacingLeft=130;spacingRight=20;" vertex="1" parent="1"><mxGeometry x="100" y="700" width="500" height="280" as="geometry"/></mxCell><mxCell id="rec_head" value="" style="ellipse;html=1;fillColor=#ffffff;strokeColor=#ffffff;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="145" y="745" width="60" height="60" as="geometry"/></mxCell><mxCell id="rec_body" value="" style="rounded=1;arcSize=30;html=1;fillColor=#ffffff;strokeColor=#ffffff;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="130" y="815" width="90" height="95" as="geometry"/></mxCell><mxCell id="enf" value="Person&lt;br&gt;&lt;b&gt;Enfermeiro(a)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Necessidades:&lt;/b&gt;&lt;br&gt;• acessar dados do paciente&lt;br&gt;• registrar acolhimento&lt;br&gt;• registrar sinais vitais&lt;br&gt;• encaminhar para atendimento" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;strokeWidth=2;fillColor=#08427B;strokeColor=#052E56;fontColor=#ffffff;align=left;verticalAlign=middle;spacingLeft=130;spacingRight=20;" vertex="1" parent="1"><mxGeometry x="100" y="1200" width="500" height="280" as="geometry"/></mxCell><mxCell id="enf_head" value="" style="ellipse;html=1;fillColor=#ffffff;strokeColor=#ffffff;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="145" y="1245" width="60" height="60" as="geometry"/></mxCell><mxCell id="enf_body" value="" style="rounded=1;arcSize=30;html=1;fillColor=#ffffff;strokeColor=#ffffff;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="130" y="1315" width="90" height="95" as="geometry"/></mxCell><mxCell id="med" value="Person&lt;br&gt;&lt;b&gt;Médico(a)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Necessidades:&lt;/b&gt;&lt;br&gt;• consultar dados do paciente&lt;br&gt;• registrar atendimento e conduta&lt;br&gt;• solicitar exames&lt;br&gt;• definir retorno" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;strokeWidth=2;fillColor=#08427B;strokeColor=#052E56;fontColor=#ffffff;align=left;verticalAlign=middle;spacingLeft=130;spacingRight=20;" vertex="1" parent="1"><mxGeometry x="2300" y="200" width="500" height="280" as="geometry"/></mxCell><mxCell id="med_head" value="" style="ellipse;html=1;fillColor=#ffffff;strokeColor=#ffffff;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="2345" y="245" width="60" height="60" as="geometry"/></mxCell><mxCell id="med_body" value="" style="rounded=1;arcSize=30;html=1;fillColor=#ffffff;strokeColor=#ffffff;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="2330" y="315" width="90" height="95" as="geometry"/></mxCell><mxCell id="diag" value="Person&lt;br&gt;&lt;b&gt;Profissional de Apoio Diagnóstico&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Necessidades:&lt;/b&gt;&lt;br&gt;• receber solicitações de exame&lt;br&gt;• registrar execução&lt;br&gt;• disponibilizar resultados" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;strokeWidth=2;fillColor=#08427B;strokeColor=#052E56;fontColor=#ffffff;align=left;verticalAlign=middle;spacingLeft=130;spacingRight=20;" vertex="1" parent="1"><mxGeometry x="2300" y="700" width="500" height="260" as="geometry"/></mxCell><mxCell id="diag_head" value="" style="ellipse;html=1;fillColor=#ffffff;strokeColor=#ffffff;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="2345" y="745" width="60" height="60" as="geometry"/></mxCell><mxCell id="diag_body" value="" style="rounded=1;arcSize=30;html=1;fillColor=#ffffff;strokeColor=#ffffff;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="2330" y="815" width="90" height="95" as="geometry"/></mxCell><mxCell id="fin" value="Person&lt;br&gt;&lt;b&gt;Administrativo / Financeiro&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Necessidades:&lt;/b&gt;&lt;br&gt;• validar cobertura&lt;br&gt;• controlar cobranças&lt;br&gt;• processar faturamento&lt;br&gt;• acompanhar pendências" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;strokeWidth=2;fillColor=#08427B;strokeColor=#052E56;fontColor=#ffffff;align=left;verticalAlign=middle;spacingLeft=130;spacingRight=20;" vertex="1" parent="1"><mxGeometry x="2300" y="1200" width="500" height="280" as="geometry"/></mxCell><mxCell id="fin_head" value="" style="ellipse;html=1;fillColor=#ffffff;strokeColor=#ffffff;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="2345" y="1245" width="60" height="60" as="geometry"/></mxCell><mxCell id="fin_body" value="" style="rounded=1;arcSize=30;html=1;fillColor=#ffffff;strokeColor=#ffffff;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="2330" y="1315" width="90" height="95" as="geometry"/></mxCell><mxCell id="dir" value="Person&lt;br&gt;&lt;b&gt;Direção / Gestão&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Necessidades:&lt;/b&gt;&lt;br&gt;• acompanhar operação&lt;br&gt;• consultar indicadores&lt;br&gt;• monitorar volume e faturamento&lt;br&gt;• apoiar decisões gerenciais" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;strokeWidth=2;fillColor=#08427B;strokeColor=#052E56;fontColor=#ffffff;align=left;verticalAlign=middle;spacingLeft=130;spacingRight=20;" vertex="1" parent="1"><mxGeometry x="2300" y="1700" width="500" height="280" as="geometry"/></mxCell><mxCell id="dir_head" value="" style="ellipse;html=1;fillColor=#ffffff;strokeColor=#ffffff;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="2345" y="1745" width="60" height="60" as="geometry"/></mxCell><mxCell id="dir_body" value="" style="rounded=1;arcSize=30;html=1;fillColor=#ffffff;strokeColor=#ffffff;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="2330" y="1815" width="90" height="95" as="geometry"/></mxCell><mxCell id="conv" value="Software System&lt;br&gt;&lt;b&gt;Operadora / Convênio de Saúde&lt;/b&gt;&lt;br&gt;&lt;br&gt;Fornece elegibilidade e autorização e recebe informações de faturamento." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;strokeWidth=2;fillColor=#999999;strokeColor=#666666;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="100" y="1800" width="500" height="220" as="geometry"/></mxCell><mxCell id="lab" value="Software System&lt;br&gt;&lt;b&gt;Laboratório / Diagnóstico Externo&lt;/b&gt;&lt;br&gt;&lt;br&gt;Recebe pedidos e devolve resultados de exames." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;strokeWidth=2;fillColor=#999999;strokeColor=#666666;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="700" y="1800" width="500" height="220" as="geometry"/></mxCell><mxCell id="notif" value="Software System&lt;br&gt;&lt;b&gt;Serviço de Notificações&lt;/b&gt;&lt;br&gt;&lt;br&gt;Entrega confirmações, lembretes e avisos ao paciente." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;strokeWidth=2;fillColor=#999999;strokeColor=#666666;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1300" y="1800" width="500" height="220" as="geometry"/></mxCell><mxCell id="pay" value="Software System&lt;br&gt;&lt;b&gt;Plataforma de Pagamentos&lt;/b&gt;&lt;br&gt;&lt;br&gt;Processa cobranças e devolve confirmações de pagamento." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;strokeWidth=2;fillColor=#999999;strokeColor=#666666;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1900" y="1800" width="500" height="220" as="geometry"/></mxCell><mxCell id="scope" value="ESCOPO&lt;br&gt;System Context C4 — visão-alvo do produto completo. O repositório atual implementa principalmente o cadastro de Pessoa/Paciente; as demais capacidades representam necessidades do sistema a construir." style="shape=note;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="850" y="1450" width="1200" height="170" as="geometry"/></mxCell><mxCell id="r1" value="Solicita cadastro, agenda atendimento e recebe orientações" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=50;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="pac" target="system"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="700" y="330"/><mxPoint x="700" y="900"/><mxPoint x="1100" y="900"/></Array></mxGeometry></mxCell><mxCell id="r2" value="Cadastra pacientes, organiza agenda e realiza check-in" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=50;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="rec" target="system"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="800" y="840"/><mxPoint x="800" y="1000"/><mxPoint x="1100" y="1000"/></Array></mxGeometry></mxCell><mxCell id="r3" value="Consulta dados e registra acolhimento/sinais vitais" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=50;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="enf" target="system"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="900" y="1340"/><mxPoint x="900" y="1100"/><mxPoint x="1100" y="1100"/></Array></mxGeometry></mxCell><mxCell id="r4" value="Consulta paciente, registra atendimento, solicita exames e define retorno" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=50;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="med" target="system"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2200" y="340"/><mxPoint x="2200" 