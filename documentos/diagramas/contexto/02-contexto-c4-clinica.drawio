<mxfile host="app.diagrams.net" modified="2026-09-29T00:00:00.000Z" agent="ChatGPT" version="26.0.0"><diagram id="c4_context_clinic" name="C4 System Context - Clínica"><mxGraphModel dx="2700" dy="2100" grid="1" gridSize="100" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2600" pageHeight="2100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="C4 — System Context Diagram — Sistema da Clínica Médica&lt;br&gt;&lt;font style='font-size:14px;font-weight:normal'&gt;Nível 1 • pessoas, sistema em foco e sistemas externos&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=26;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="400" y="0" width="1800" height="100" as="geometry"/></mxCell><mxCell id="focus" value="Software System&lt;br&gt;&lt;b&gt;Sistema da Clínica Médica&lt;/b&gt;&lt;br&gt;&lt;br&gt;Gerencia a jornada do paciente: cadastro, agenda, recepção, atendimento, exames, retorno, faturamento e informações gerenciais." style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fontStyle=1;strokeWidth=3;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="950" y="700" width="600" height="420" as="geometry"/></mxCell><mxCell id="pac" value="Person&lt;br&gt;&lt;b&gt;Paciente&lt;/b&gt;&lt;br&gt;Solicita atendimento, fornece dados e recebe orientações." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;strokeWidth=2;fillColor=#08427B;strokeColor=#052E56;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="100" y="300" width="400" height="180" as="geometry"/></mxCell><mxCell id="rec" value="Person&lt;br&gt;&lt;b&gt;Recepcionista&lt;/b&gt;&lt;br&gt;Executa cadastro, agendamento e check-in." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;strokeWidth=2;fillColor=#08427B;strokeColor=#052E56;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="100" y="700" width="400" height="180" as="geometry"/></mxCell><mxCell id="enf" value="Person&lt;br&gt;&lt;b&gt;Enfermeiro(a)&lt;/b&gt;&lt;br&gt;Realiza acolhimento e registra sinais vitais." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;strokeWidth=2;fillColor=#08427B;strokeColor=#052E56;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="100" y="1100" width="400" height="180" as="geometry"/></mxCell><mxCell id="med" value="Person&lt;br&gt;&lt;b&gt;Médico(a)&lt;/b&gt;&lt;br&gt;Consulta dados clínicos e registra diagnóstico/conduta." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;strokeWidth=2;fillColor=#08427B;strokeColor=#052E56;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="2000" y="300" width="400" height="180" as="geometry"/></mxCell><mxCell id="diag" value="Person&lt;br&gt;&lt;b&gt;Apoio Diagnóstico&lt;/b&gt;&lt;br&gt;Executa procedimentos e registra resultados." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;strokeWidth=2;fillColor=#08427B;strokeColor=#052E56;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="2000" y="700" width="400" height="180" as="geometry"/></mxCell><mxCell id="fin" value="Person&lt;br&gt;&lt;b&gt;Administrativo / Financeiro&lt;/b&gt;&lt;br&gt;Opera cobrança, convênios e faturamento." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;strokeWidth=2;fillColor=#08427B;strokeColor=#052E56;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="2000" y="1100" width="400" height="180" as="geometry"/></mxCell><mxCell id="dir" value="Person&lt;br&gt;&lt;b&gt;Direção / Gestão&lt;/b&gt;&lt;br&gt;Consulta indicadores e informações gerenciais." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;strokeWidth=2;fillColor=#08427B;strokeColor=#052E56;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="2000" y="1500" width="400" height="180" as="geometry"/></mxCell><mxCell id="conv" value="Software System&lt;br&gt;&lt;b&gt;Operadora / Convênio de Saúde&lt;/b&gt;&lt;br&gt;Sistema externo para elegibilidade, autorização e faturamento." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;